---
import Layout from "../../layouts/Layout.astro";
import Loader from "../../components/loader/Loader.astro";
---

<script>
  import { requireAuth } from "../../scripts/auth";
  import {
    firstAccessibleSectionForRole,
    type DashboardRole,
  } from "../../scripts/dashboardSections";

  // /dashboard/ used to be a profile picker (Docente/Tutor/Administrador
  // buttons); now that role no longer selects a whole nav mode, this is just
  // a router straight to the first section the logged-in role can reach.
  const user = await requireAuth(["TEACHER", "COUNSELOR", "ADMIN"]);
  if (user) {
    const section = firstAccessibleSectionForRole(user.role as DashboardRole);
    if (section) {
      window.location.replace(
        `${import.meta.env.BASE_URL}${section.path}`,
      );
    }
  }
</script>

<Layout>
  <div class="flex flex-col items-center grow gap-y-4 relative w-full">
    <Loader show="true" />
  </div>
</Layout>
