---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import ListadosPanel from "../../components/dashboard/listados/ListadosPanel.astro";
---

<script>
  import { requireAuth } from "../../scripts/auth";
  import { rolesFor } from "../../scripts/dashboardSections";
  requireAuth(rolesFor("listados"));
</script>

<DashboardLayout>
  <div class="w-full h-full flex flex-col items-center overflow-y-scroll">
    <h1 class="text-[30px] md:text-[36px] font-bold pt-4 pb-2">Listados</h1>
    <h2 class="text-[16px] md:text-[20px] pb-4">
      Descargá el listado de estudiantes de una materia en formato CSV.
    </h2>
    <ListadosPanel />
  </div>
</DashboardLayout>
