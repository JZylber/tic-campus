import GrillaProyectoPanel from "../../components/dashboard/grillaProyecto/GrillaProyectoPanel.astro";
---

<script>
  import { requireAuth } from "../../scripts/auth";
  import { rolesFor } from "../../scripts/dashboardSections";
  requireAuth(rolesFor("grilla"));
</script>

<DashboardLayout>
  <div class="w-full h-full flex flex-col items-center overflow-y-scroll">
    <h1 class="text-[30px] md:text-[36px] font-bold pt-4 pb-2">Grilla</h1>
    <h2 class="text-[16px] md:text-[20px] pb-4">
      Horario general de Proyecto por nivel y rotación.
    </h2>
    <GrillaProyectoPanel />
  </div>
</DashboardLayout>
