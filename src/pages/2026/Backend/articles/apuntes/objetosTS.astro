      <td><InlineCodeBlock lang="ts" code="let pokedex: Pokemon[] = [];" /></td>
    </tr>
    <tr>
      <td>Objeto a JSON</td>
      <td><InlineCodeBlock lang="ts" code="JSON.stringify(pokemon);" /></td>
    </tr>
