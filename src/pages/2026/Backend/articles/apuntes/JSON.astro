  <thead>
    <tr>
      <th>Acción</th>
      <th>Ejemplo</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>Importar las funciones de archivos</td>
      <td
        ><InlineCodeBlock
          lang="ts"
          code='import { readFileSync, writeFileSync } from "node:fs";'
        /></td
      >
    </tr>
    <tr>
      <td>Objeto o array a texto JSON</td>
      <td
        ><InlineCodeBlock
          lang="ts"
          code="let texto: string = JSON.stringify(datos, null, 2);"
        /></td
      >
    </tr>
    <tr>
      <td>Texto JSON a datos (¡tipado!)</td>
      <td
        ><InlineCodeBlock
          lang="ts"
          code="let datos: Persona[] = JSON.parse(texto) as Persona[];"
        /></td
      >
    </tr>
    <tr>
      <td>Leer un archivo JSON</td>
      <td
        ><InlineCodeBlock
          lang="ts"
          code='let guardado: string = readFileSync("datos.json", "utf-8");'
        /></td
      >
    </tr>
    <tr>
      <td>Escribir un archivo JSON</td>
      <td
        ><InlineCodeBlock
          lang="ts"
          code='writeFileSync("datos.json", texto, "utf-8");'
        /></td
      >
    </tr>
    <tr>
      <td>Ejecutar el programa</td>
      <td><InlineCodeBlock lang="bash" code="npx tsx index.ts" /></td>
    </tr>
  </tbody>
</table>
