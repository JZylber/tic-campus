---
import Loader from "../../loader/Loader.astro";
import Radio from "../../misc/radio/Radio.astro";
import Toggle from "../../misc/toggle/Toggle.astro";
import TimetableGrid from "../../sections/timetable/TimetableGrid.astro";
---

<script>
  import setAlpineData from "../../../scripts/alpine/setAlpineData";
  import grillaProyectoPageData from "../../../scripts/alpine/data/grillaProyectoPage";

  setAlpineData("grillaProyectoPage", grillaProyectoPageData);
</script>
<div class="w-full flex justify-center py-4" x-data="grillaProyectoPage()">
  <Loader show="loading" />

  <div class="w-full flex flex-col gap-y-4 px-4" x-show="!loading">
    <div class="flex flex-col gap-y-4 py-2 md:flex-row md:items-end md:gap-x-8 w-full">
      <Radio title="Nivel" xModel="level" options="levelOptions" className="w-full md:w-1/4" />
      <Toggle
        title="Cuatrimestre"
        xModel="cuatrimestre"
        options="cuatrimestreOptions"
        className="w-full md:w-1/3"
      />
    </div>
    <TimetableGrid
      personalizedAvailable={false}
      showPersonalizedTab={false}
      tabs="levelTabs"
      alwaysShowTabs={true}
    />
  </div>
</div>
