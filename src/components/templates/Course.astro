---
import Navbar from "../navbar/Navbar.astro";
import Home from "../sections/home/Home.astro";
import InfoHome from "../sections/home/InfoHome.astro";
import Activities from "../sections/activities/Activities.astro";
import Redos from "../sections/redo/Redos.astro";
import Program from "../sections/program/Program.astro";
import Material from "../sections/material/Material.astro";
import Queries from "../sections/queries/Queries.astro";
import Mark from "../sections/mark/Mark.astro";
import {
  COURSE_TEMPLATES,
  type CourseSection,
} from "../../scripts/courseTemplates";

interface Props {
  template: string;
  subject: string;
  course: string;
  year: number;
}

const { template, subject, course, year } = Astro.props;
const { presentation, infoHome, sections } = COURSE_TEMPLATES[template];

// No "notas" entry: MarkLink reaches that section, not the nav.
const NAV_ITEMS: Partial<Record<CourseSection, { icon: string; title: string }>> = {
  home: { icon: "home", title: subject },
  actividades: { icon: "school", title: "Actividades" },
  reentregas: { icon: "refresh", title: "Reentregas" },
  programa: { icon: "event_note", title: "Programa" },
  material: { icon: "construction", title: "Material" },
  consultas: { icon: "support_agent", title: "Consultas" },
};
const items = sections
  .filter((s) => NAV_ITEMS[s])
  .map((name) => ({ name, ...NAV_ITEMS[name]! }));
const position = (s: CourseSection) => sections.indexOf(s);
const has = (s: CourseSection) => sections.includes(s);
const HomeSection = infoHome ? InfoHome : Home;
---

{
  sections.length === 0 ? (
    <p>
      {subject} {course} {year}
    </p>
  ) : (
    <>
      <Navbar course={course} subject={subject} items={items} />
      <main
        class="relative grow bg-gray-50 border-y sm:border-r lg:border-l border-gray-300 sm:rounded-r-xl lg:rounded-l-xl overflow-hidden"
        x-init={`$store.course.setCourse('${course}');$store.student.getStudentData('${subject}',${year})`}
      >
        <HomeSection
          subject={subject}
          course={course}
          year={year}
          position={position("home")}
          presentation={presentation}
        />
        <Activities
          subject={subject}
          course={course}
          year={year}
          position={position("actividades")}
        />
        {has("reentregas") && (
          <Redos
            subject={subject}
            course={course}
            year={year}
            position={position("reentregas")}
          />
        )}
        {has("programa") && (
          <Program subject={subject} year={year} position={position("programa")} />
        )}
        <Material
          subject={subject}
          course={course}
          year={year}
          position={position("material")}
        />
        {has("consultas") && <Queries position={position("consultas")} />}
        {has("notas") && (
          <Mark
            subject={subject}
            course={course}
            year={year}
            position={position("notas")}
          />
        )}
      </main>
    </>
  )
}
